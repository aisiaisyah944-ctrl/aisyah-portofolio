* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

:root {
    --pink: #d98fa5;
    --light-pink: #fcecf1;
    --cream: #fffaf6;
    --dark: #493942;
    --text: #75636c;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--cream);
    color: var(--dark);
}

header {
    background: rgba(255,250,246,0.95);
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar {
    max-width: 1100px;
    margin: auto;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 25px;
    font-weight: 700;
    color: var(--dark);
    text-decoration: none;
}

.logo span, .section-title span {
    color: var(--pink);
}

.nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    text-decoration: none;
    color: var(--dark);
    font-size: 14px;
    transition: .3s;
}

.nav-links a:hover {
    color: var(--pink);
}

.menu-btn {
    display: none;
    border: none;
    background: none;
    font-size: 25px;
    cursor: pointer;
}

.hero {
    max-width: 1100px;
    min-height: 620px;
    margin: auto;
    padding: 70px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
}

.hero-text {
    flex: 1;
}

.greeting, .subtitle {
    color: var(--pink);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 3px;
}

.hero h1 {
    font-size: 45px;
    margin: 20px 0;
    line-height: 1.3;
}

.hero h1 span {
    color: var(--pink);
}

.hero h2 {
    font-size: 19px;
    font-weight: 500;
}

.description {
    color: var(--text);
    line-height: 1.9;
    margin: 20px 0 30px;
    max-width: 500px;
}

.btn {
    display: inline-block;
    background: var(--pink);
    color: white;
    padding: 13px 25px;
    border-radius: 30px;
    text-decoration: none;
    transition: .3s;
}

.btn:hover {
    background: var(--dark);
    transform: translateY(-4px);
}

.hero-image {
    flex: 1;
    display: flex;
    justify-content: center;
}

.image-frame {
    width: 320px;
    height: 390px;
    border: 8px solid var(--light-pink);
    border-radius: 160px 160px 30px 30px;
    overflow: hidden;
    background: var(--light-pink);
}

.image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.section {
    padding: 90px 25px;
    text-align: center;
}

.section-title {
    font-size: 35px;
    margin: 12px 0 40px;
}

.about {
    background: var(--light-pink);
}

.about-card {
    max-width: 750px;
    margin: auto;
    background: white;
    padding: 35px;
    border-radius: 20px;
    text-align: left;
    color: var(--text);
    line-height: 2;
}

.about-card p + p {
    margin-top: 15px;
}

.skill-container, .project-container {
    max-width: 1050px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.skill-card, .project-card {
    background: white;
    padding: 30px 20px;
    border-radius: 18px;
    box-shadow: 0 5px 20px rgba(100,50,70,.06);
    transition: .3s;
}

.skill-card {
    font-size: 30px;
}

.skill-card h3, .project-card h3 {
    font-size: 17px;
    margin: 15px 0 8px;
}

.skill-card p, .project-card p {
    font-size: 13px;
    color: var(--text);
}

.skill-card:hover, .project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 25px rgba(100,50,70,.12);
}

.education {
    background: var(--light-pink);
}

.education-card {
    max-width: 550px;
    background: white;
    margin: auto;
    padding: 30px;
    border-left: 5px solid var(--pink);
    border-radius: 15px;
    text-align: left;
}

.education-card p {
    color: var(--text);
    margin: 10px 0;
}

.education-card span {
    color: var(--pink);
    font-size: 13px;
}

.project-icon {
    font-size: 40px;
}

.contact > p:not(.subtitle) {
    color: var(--text);
}

.contact-links {
    margin-top: 25px;
    display: flex;
    justify-content: center;
    gap: 15px;
}

.contact-links a {
    text-decoration: none;
    background: var(--light-pink);
    color: var(--dark);
    padding: 12px 25px;
    border-radius: 25px;
    transition: .3s;
}

.contact-links a:hover {
    background: var(--pink);
    color: white;
}

footer {
    background: var(--dark);
    color: white;
    padding: 25px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    font-size: 12px;
    gap: 15px;
}

footer a {
    color: #f4b8cb;
    text-decoration: none;
}

@media (max-width: 768px) {
    .menu-btn {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background: var(--cream);
        flex-direction: column;
        text-align: center;
        padding: 25px;
        gap: 20px;
    }

    .nav-links.active {
        display: flex;
    }

    .hero {
        flex-direction: column-reverse;
        text-align: center;
        padding-top: 40px;
    }

    .hero h1 {
        font-size: 32px;
    }

    .hero-image {
        width: 100%;
    }

    .image-frame {
        width: 240px;
        height: 290px;
    }

    .description {
        margin-left: auto;
        margin-right: auto;
    }

    .skill-container, .project-container {
        grid-template-columns: 1fr;
    }

    .section-title {
        font-size: 29px;
    }

    footer {
        flex-direction: column;
        text-align: center;
    }
}
